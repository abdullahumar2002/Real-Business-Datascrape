# OpenAI API Key (optional - used for AI classification tasks)
# OPENAI_API_KEY=your_openai_api_key_here

# Google Places API Key (optional - for real business data collection)
# Get from: https://console.cloud.google.com/
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Crunchbase API Key (optional - for startup/tech company data)
# Get from: https://developer.crunchbase.com/
# CRUNCHBASE_API_KEY=your_crunchbase_api_key_here

# Target Configuration
TARGET_TOTAL=500
UAE_TARGET=250
USA_TARGET=250

# Rate Limiting
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Database
DATABASE_PATH=data/business.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Output
OUTPUT_DIR=output
